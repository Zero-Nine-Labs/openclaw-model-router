{
  "id": "model-router",
  "name": "Difficulty and urgency model router",
  "version": "0.2.4-jev-experimental",
  "description": "Classify with JEV; route model and effort using current-task complexity, ambiguity and consequences.",
  "activation": {
    "onCapabilities": [
      "hook"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enableEval": {
        "type": "boolean",
        "default": false
      },
      "agentIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "main"
        ]
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 15000,
        "default": 8000
      },
      "maxPromptChars": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 64000,
        "default": 24000
      },
      "sessionTtlMs": {
        "type": "integer",
        "minimum": 60000,
        "maximum": 86400000,
        "default": 1800000
      },
      "maxSessions": {
        "type": "integer",
        "minimum": 10,
        "maximum": 5000,
        "default": 500
      }
    }
  }
}
